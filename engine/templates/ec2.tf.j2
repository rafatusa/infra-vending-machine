# Generated by infra-vending-machine engine
# Request:     {{ request_name }}
# Issue:       #{{ issue_number }}
# Environment: {{ environment }} | Account: {{ account }}
# DO NOT EDIT — re-submit a GitHub Issue to modify or destroy this resource

variable "project_name" {
  description = "Resource name"
  type        = string
  default     = "{{ project_name }}"
}

variable "ssh_public_key" {
  description = "SSH public key for EC2 instance access"
  type        = string
  sensitive   = true
}

module "ec2_sg" {
  source = "{{ sg_module_source }}"

  project_name = var.project_name
  vpc_id       = data.aws_vpc.target.id
}

module "ec2" {
  source = "{{ module_source }}"

  project_name     = var.project_name
  ami_id           = data.aws_ami.al2023.id
  instance_type    = "{{ instance_type }}"
  subnet_id        = data.aws_subnet.target.id
  security_groups  = [module.ec2_sg.security_group_id]
  ssh_public_key   = var.ssh_public_key
  root_volume_size = {{ root_volume_size }}
}
